{
  "name": "fathom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:start": "tsx --env-file-if-exists=.env scripts/db.ts start",
    "db:stop": "tsx --env-file-if-exists=.env scripts/db.ts stop",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "bot": "tsx --env-file-if-exists=.env bot/index.ts",
    "bot:login": "tsx --env-file-if-exists=.env bot/index.ts --login",
    "process": "tsx --env-file-if-exists=.env scripts/process.ts",
    "dev:all": "concurrently -n web,bot -c cyan,magenta \"npm run dev\" \"npm run bot\"",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.63.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "engines": {
    "node": ">=22.12"
  }
}
