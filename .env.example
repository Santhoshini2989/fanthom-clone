# ---- Fathom clone: local-first configuration -------------------------------
# Copy this file to .env and fill in the values. .env is git-ignored.

# Google Gemini API key (https://aistudio.google.com/apikey). Required for
# transcription and meeting intelligence. Never commit the real key.
GEMINI_API_KEY=

# Local PostgreSQL. `npm run db:start` boots an embedded PostgreSQL on this
# URL (no admin install needed). Point it at your own server if you prefer.
DATABASE_URL=postgresql://fathom:fathom@127.0.0.1:5433/fathom

# Where recordings / clips / exports are written (relative to the repo root).
STORAGE_DIR=./storage

# Gemini models (override only if Google renames them)
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
# Max seconds per transcription request (diarization caps at 30 min)
TRANSCRIBE_CHUNK_SECONDS=1500

# Meeting bot
BOT_NAME=Fathom Notetaker
BOT_PROFILE_DIR=./.bot-profile
# "chrome" uses your installed Google Chrome (best for Google sign-in);
# "chromium" uses the Playwright-managed browser.
BOT_BROWSER_CHANNEL=chrome
# real = capture the Meet tab's audio; mock = write a placeholder recording
RECORDING_PROVIDER=real
# Give up if the bot is not admitted within this many seconds
BOT_ADMISSION_TIMEOUT_SECONDS=300
# Stop automatically after everyone else leaves for this many seconds
BOT_ALONE_TIMEOUT_SECONDS=90
# Hard cap on a single recording (seconds)
BOT_MAX_RECORDING_SECONDS=10800

# Only when the bot runs on a different machine than the web app (see docs/DEPLOY.md):
# public URL of the web app, e.g. https://fathom-web.up.railway.app
WEB_BASE_URL=
